# Secret references for the optional LLM-judge eval (the only thing in this
# project that needs a credential). This file holds 1Password *references*,
# not values, so it is safe to commit. Resolve them at run time with:
#
#   op run --env-file=.env.example -- env EVAL_LLM_JUDGE=1 uv run pytest -m eval -v
#
# Point the reference at your own vault/item.
# Do not create a plaintext `.env` (it is gitignored, but one `git add -f`
# or screen-share away from exposure).
ANTHROPIC_API_KEY=op://Private/Anthropic API/credential
